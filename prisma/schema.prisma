generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  phone        String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  emailVerified        Boolean   @default(false)
  verifyToken          String?   @unique
  verifyTokenExpiresAt DateTime?

  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  sessionVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  doctor        Doctor?
  notifications Notification[]
  blogs         Blog[]
  mediaAssets   MediaAsset[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([role])
  @@index([emailVerified])
  @@map("users")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action   String
  entity   String?
  entityId String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model ConsultationInquiry {
  id          String             @id @default(cuid())
  name        String
  email       String
  phone       String?
  treatmentId String
  message     String
  status      ConsultationStatus @default(PENDING)
  doctorId    String?

  doctor    Doctor?   @relation(fields: [doctorId], references: [id])
  treatment Treatment @relation(fields: [treatmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treatmentId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
  @@map("consultation_inquiries")
}

model Treatment {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  consultations ConsultationInquiry[]

  @@map("treatments")
}

model Pharmacy {
  id            String   @id @default(cuid())
  name          String
  description   String?
  image         String?
  imagePublicId String?
  address       String?
  phone         String?
  website       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@map("pharmacies")
}

model Doctor {
  id             String  @id @default(cuid())
  name           String
  qualification  String
  specialization String?
  experience     String?
  description    String?
  image          String?
  imagePublicId  String?
  isActive       Boolean @default(true)

  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  consultations ConsultationInquiry[]
  user          User?                 @relation(fields: [userId], references: [id])
  notifications Notification[]

  schedule       DoctorSchedule?
  slots          AvailableSlot[]
  scheduleBlocks DoctorScheduleBlock[]

  @@map("doctors")
}

model Appointment {
  id              String            @id @default(cuid())
  name            String
  email           String
  concerns        String
  meetingType     MeetingType
  appointmentDate DateTime
  appointmentTime String
  status          AppointmentStatus @default(PENDING)

  userId   String?
  doctorId String

  slotId String? @unique

  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  userHiddenAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectionProvider MeetingProvider @default(NONE)

  doctor Doctor @relation(fields: [doctorId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  slot          AvailableSlot? @relation(fields: [slotId], references: [id])
  meeting       Meeting?
  notifications Notification[]

  @@index([userId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@index([userHiddenAt])
  @@index([connectionProvider])
  @@map("appointments")
}

model Meeting {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  type          MeetingType
  status        MeetingStatus @default(CREATED)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalMeetingId String?
  hostUrl           String?
  meetingUrl        String?
  provider          MeetingProvider @default(NONE)
  roomName          String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([status])
  @@index([externalMeetingId])
  @@index([roomName])
  @@map("meetings")
}

model Notification {
  id            String  @id @default(cuid())
  userId        String?
  doctorId      String?
  appointmentId String?

  type    NotificationType
  title   String
  message String

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([doctorId, isRead])
  @@index([appointmentId])
  @@index([createdAt])
  @@map("notifications")
}

model Blog {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?
  content       String
  category      String?
  image         String?
  imagePublicId String?
  status        BlogStatus @default(DRAFT)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
  @@map("blogs")
}

model MediaAsset {
  id           String  @id @default(cuid())
  url          String
  publicId     String  @unique
  resourceType String  @default("image")
  folder       String?
  originalName String?
  format       String?
  width        Int?
  height       Int?
  size         Int?

  uploadedById String?

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([folder])
  @@index([createdAt])
  @@map("media_assets")
}

model DoctorSchedule {
  id           String  @id @default(cuid())
  doctorId     String  @unique
  timezone     String  @default("Asia/Karachi")
  slotDuration Int     @default(30)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor       Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  workingHours DoctorWorkingHour[]

  @@map("doctor_schedules")
}

model DoctorWorkingHour {
  id         String  @id @default(cuid())
  scheduleId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean @default(true)

  schedule DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([dayOfWeek])
  @@map("doctor_working_hours")
}

model DoctorScheduleBlock {
  id       String   @id @default(cuid())
  doctorId String
  date     DateTime
  reason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([doctorId, date])
  @@map("doctor_schedule_blocks")
}

model AvailableSlot {
  id            String     @id @default(cuid())
  doctorId      String
  date          DateTime
  startTime     String
  endTime       String
  status        SlotStatus @default(AVAILABLE)
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
  @@index([doctorId, status])
  @@index([date])
  @@map("available_slots")
}

model ClinicScheduleBlock {
  id     String   @id @default(cuid())
  date   DateTime
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("clinic_schedule_blocks")
}

enum UserRole {
  USER
  ADMIN
  DOCTOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MeetingType {
  CLINIC
  VIDEO
  VOICE
}

enum MeetingProvider {
  NONE
  ZOOM
  GOOGLE_MEET
  LIVEKIT
  WHATSAPP
}

enum MeetingStatus {
  CREATED
  WAITING
  LIVE
  ENDED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  MEETING_READY
  MEETING_STARTED
  SYSTEM
}

enum BlogStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ConsultationStatus {
  PENDING
  ASSIGNED
  IN_REVIEW
  CONTACTED
  APPOINTMENT_CREATED
  COMPLETED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}
