generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String
  passwordHash         String
  phone                String?
  role                 UserRole       @default(USER)
  emailVerified        Boolean        @default(false)
  verifyToken          String?        @unique
  verifyTokenExpiresAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  appointments         Appointment[]
  doctor               Doctor?
  notifications        Notification[]

  @@map("users")
}

model ConsultationInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  treatment String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consultation_inquiries")
}

model Treatment {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("treatments")
}

model Doctor {
  id             String         @id @default(cuid())
  name           String
  qualification  String
  specialization String?
  experience     String?
  description    String?
  image          String?
  isActive       Boolean        @default(true)
  userId         String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  appointments   Appointment[]
  user           User?          @relation(fields: [userId], references: [id])
  notifications  Notification[]

  @@map("doctors")
}

model Appointment {
  id                 String            @id @default(cuid())
  name               String
  email              String
  concerns           String
  meetingType        MeetingType
  appointmentDate    DateTime
  appointmentTime    String
  status             AppointmentStatus @default(PENDING)
  userId             String?
  doctorId           String
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  userHiddenAt       DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  connectionProvider MeetingProvider   @default(NONE)
  doctor             Doctor            @relation(fields: [doctorId], references: [id])
  user               User?             @relation(fields: [userId], references: [id])
  meeting            Meeting?
  notifications      Notification[]

  @@index([userId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@index([userHiddenAt])
  @@index([connectionProvider])
  @@map("appointments")
}

model Meeting {
  id                String          @id @default(cuid())
  appointmentId     String          @unique
  type              MeetingType
  status            MeetingStatus   @default(CREATED)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  externalMeetingId String?
  hostUrl           String?
  meetingUrl        String?
  provider          MeetingProvider @default(NONE)
  roomName          String?
  appointment       Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([status])
  @@index([externalMeetingId])
  @@index([roomName])
  @@map("meetings")
}

model Notification {
  id            String           @id @default(cuid())
  userId        String?
  doctorId      String?
  appointmentId String?
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor?          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([doctorId, isRead])
  @@index([appointmentId])
  @@index([createdAt])
  @@map("notifications")
}

enum UserRole {
  USER
  ADMIN
  DOCTOR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MeetingType {
  CLINIC
  VIDEO
  VOICE
}

enum MeetingProvider {
  NONE
  ZOOM
  GOOGLE_MEET
  LIVEKIT
  WHATSAPP
}

enum MeetingStatus {
  CREATED
  WAITING
  LIVE
  ENDED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  MEETING_READY
  MEETING_STARTED
  SYSTEM
}
