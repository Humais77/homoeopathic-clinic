generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String
  passwordHash  String
  phone         String?
  whatsappOptIn Boolean @default(false)

  // Profile change limits
  nameChangeCount  Int @default(0)
  phoneChangeCount Int @default(0)

  role                        UserRole          @default(USER)
  emailVerified               Boolean           @default(false)
  verifyToken                 String?           @unique
  verifyTokenExpiresAt        DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  passwordResetToken          String?           @unique
  passwordResetTokenExpiresAt DateTime?
  sessionVersion              Int               @default(0)
  status                      UserStatus        @default(ACTIVE)

  appointments      Appointment[]
  auditLogs         AuditLog[]
  blogs             Blog[]
  doctor            Doctor?
  mediaAssets       MediaAsset[]
  notifications     Notification[]
  treatments        Treatment[]
  whatsappMessages  WhatsAppMessage[]
  payments          Payment[]

  @@index([status])
  @@index([role])
  @@index([emailVerified])
  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model ConsultationInquiry {
  id          String             @id @default(cuid())
  name        String
  email       String
  message     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  doctorId    String?
  phone       String?
  treatmentId String
  status      ConsultationStatus @default(PENDING)
  doctor      Doctor?            @relation(fields: [doctorId], references: [id])
  treatment   Treatment          @relation(fields: [treatmentId], references: [id])

  @@index([treatmentId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
  @@map("consultation_inquiries")
}

model Treatment {
  id            String                @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  authorId      String?
  category      String?
  content       String?
  image         String?
  imagePublicId String?
  reviewedAt    DateTime?
  reviewedById  String?
  slug          String?
  status        TreatmentStatus       @default(DRAFT)
  consultations ConsultationInquiry[]
  author        User?                 @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([isActive])
  @@index([createdAt])
  @@map("treatments")
}

model Pharmacy {
  id            String   @id @default(cuid())
  name          String
  description   String?
  image         String?
  imagePublicId String?
  address       String?
  phone         String?
  website       String?
  mapsUrl       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
  @@map("pharmacies")
}

model Doctor {
  id             String                @id @default(cuid())
  name           String
  qualification  String
  specialization String?
  experience     String?
  description    String?
  image          String?
  isActive       Boolean               @default(true)
  userId         String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  imagePublicId  String?
  appointments   Appointment[]
  slots          AvailableSlot[]
  consultations  ConsultationInquiry[]
  scheduleBlocks DoctorScheduleBlock[]
  schedule       DoctorSchedule?
  user           User?                 @relation(fields: [userId], references: [id])
  notifications  Notification[]

  @@map("doctors")
}

model Appointment {
  id              String            @id @default(cuid())
  name            String
  email           String
  concerns        String
  meetingType     MeetingType
  appointmentDate DateTime
  appointmentTime String
  status          AppointmentStatus @default(PENDING)

  userId   String?
  doctorId String

  fee      Decimal @db.Decimal(12, 2)
  currency String  @default("PKR")

  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  userHiddenAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectionProvider MeetingProvider @default(NONE)
  slotId             String?         @unique

  doctor Doctor         @relation(fields: [doctorId], references: [id])
  slot   AvailableSlot? @relation(fields: [slotId], references: [id])
  user   User?          @relation(fields: [userId], references: [id])

  meeting Meeting?
  payment Payment?

  notifications    Notification[]
  whatsappMessages WhatsAppMessage[]

  @@index([userId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
  @@index([userHiddenAt])
  @@index([connectionProvider])
  @@map("appointments")
}

model Meeting {
  id                String          @id @default(cuid())
  appointmentId     String          @unique
  type              MeetingType
  status            MeetingStatus   @default(CREATED)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  externalMeetingId String?
  hostUrl           String?
  meetingUrl        String?
  provider          MeetingProvider @default(NONE)
  roomName          String?
  appointment       Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([status])
  @@index([externalMeetingId])
  @@index([roomName])
  @@map("meetings")
}

model Notification {
  id            String           @id @default(cuid())
  userId        String?
  doctorId      String?
  appointmentId String?
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor?          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([doctorId, isRead])
  @@index([appointmentId])
  @@index([createdAt])
  @@map("notifications")
}

model Blog {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?
  content       String
  category      String?
  image         String?
  status        BlogStatus @default(DRAFT)
  authorId      String
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  imagePublicId String?
  author        User       @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
  @@map("blogs")
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  publicId     String   @unique
  resourceType String   @default("image")
  folder       String?
  originalName String?
  format       String?
  width        Int?
  height       Int?
  size         Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([folder])
  @@index([createdAt])
  @@map("media_assets")
}

model DoctorSchedule {
  id           String              @id @default(cuid())
  doctorId     String              @unique
  timezone     String              @default("Asia/Karachi")
  slotDuration Int                 @default(30)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  doctor       Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  workingHours DoctorWorkingHour[]

  @@map("doctor_schedules")
}

model DoctorWorkingHour {
  id         String         @id @default(cuid())
  scheduleId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean        @default(true)
  schedule   DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([dayOfWeek])
  @@map("doctor_working_hours")
}

model DoctorScheduleBlock {
  id        String   @id @default(cuid())
  doctorId  String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([doctorId, date])
  @@map("doctor_schedule_blocks")
}

model AvailableSlot {
  id            String       @id @default(cuid())
  doctorId      String
  date          DateTime
  startTime     String
  endTime       String
  status        SlotStatus   @default(AVAILABLE)
  blockedReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  appointment   Appointment?
  doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
  @@index([doctorId, status])
  @@index([date])
  @@map("available_slots")
}

model ClinicScheduleBlock {
  id        String   @id @default(cuid())
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("clinic_schedule_blocks")
}

model WhatsAppMessage {
  id String @id @default(cuid())

  userId        String?
  appointmentId String?

  phone  String
  type   WhatsAppMessageType
  status WhatsAppMessageStatus @default(PENDING)

  templateName String?
  message      String?

  providerId String?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?        @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([appointmentId])
  @@index([phone])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

model Payment {
  id String @id @default(cuid())

  appointmentId String  @unique
  userId        String?

  provider PaymentProvider
  method   PaymentMethod

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("PKR")

  status PaymentStatus @default(PENDING)

  transactionId     String?
  providerPaymentId String?
  providerReference String?

  trackerToken String?

  checkoutUrl String?

  failureReason String?

  paidAt    DateTime?
  expiresAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([transactionId])
  @@index([providerPaymentId])
  @@index([trackerToken])
  @@index([createdAt])
  @@map("payments")
}

enum UserRole {
  USER
  ADMIN
  DOCTOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MeetingType {
  CLINIC
  VIDEO
  VOICE
}

enum MeetingProvider {
  NONE
  ZOOM
  GOOGLE_MEET
  LIVEKIT
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppMessageType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  MEETING_READY
  CUSTOM
}

enum MeetingStatus {
  CREATED
  WAITING
  LIVE
  ENDED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  MEETING_READY
  MEETING_STARTED
  SYSTEM
}

enum BlogStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ConsultationStatus {
  PENDING
  ASSIGNED
  IN_REVIEW
  CONTACTED
  APPOINTMENT_CREATED
  COMPLETED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum TreatmentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum PaymentProvider {
  SAFEPAY
}

enum PaymentMethod {
  CARD
  BANK
  WALLET
  RAAST
  UNKNOWN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
}
